// ==============================================================================

function power(@base, $exponent) {
    _result = 1;
    _count = 0;
    while (_count < $exponent) {
        _result = _result * @base;
        _count += 1;
    }
    return _result;
}

function factorial($n) {
    if ($n <= 1) {
        return 1;
    }
    _accum = 1;
    _k = 2;
    while (_k <= $n) {
        _accum = _accum * _k;
        _k += 1;
    }
    return _accum;
}

function clamp($val, $min_val, $max_val) {
    if ($val < $min_val) {
        return $min_val;
    }
    if ($val > $max_val) {
        return $max_val;
    }
    return $val;
}

print(">>> [math_lib.bl] Mathematical utilities loaded successfully!");
