// ==============================================================================
// BLang Dynamic Typing & Flexible Coercion (test_error.bl)
// Clean Variable Declaration Syntax: biến = giá trị (KHÔNG CẦN let)
// ==============================================================================

$user_title = "Commander Shepard - Level ";
@level_number = 60;

// HỆ THỐNG KIỂU ĐỘNG LINH HOẠT:
// Trong BLang, kiểu dữ liệu linh hoạt và tự nhiên (như Python/JavaScript).
// Phép cộng chuỗi và số tự động kết hợp thành chuỗi liền mạch:
$player_profile = $user_title + @level_number;

print(">>> Kết quả ghép chuỗi linh hoạt:", $player_profile);

// Thử nghiệm compound assignment linh hoạt
$score_text = "Điểm số đạt được: ";
$score_text += 950;
print(">>> Compound assignment linh hoạt:", $score_text);

print(">>> Dynamic type execution completed with 100% success!");
